//@version=6
indicator('Orca HTF Fractals', overlay = true, max_labels_count = 500, max_lines_count = 50)

// =========================================================
// Williams Fractals (TradingView Fractals, Periods = N)
//
// Markers = circles (no H/L text), color by bias:
//   Uptrend  (HH / HL) → green
//   Downtrend (LH / LL) → red
//
// 50% lines: toggle each TF separately (1H / 15m / 5m / 1m)
// with its own color — e.g. on 1m see all four mids at once.
//
// Map (markers): 1H→1H | 15m→1H | 5m→15m | 1m→5m
// =========================================================

periods = input.int(3, 'Periods', minval = 2, group = 'Fractal', tooltip = 'Same as TradingView Fractals → Periods.')
left  = periods
right = periods

minSwingAtr = input.float(0.0, 'Min swing (× ATR)', minval = 0.0, step = 0.1, group = 'Filter')
atrLen      = input.int(14, 'ATR Length', minval = 1, group = 'Filter')
keepLastN   = input.int(50, 'Keep last N highs + N lows (0 = all)', minval = 0, group = 'Filter')

upColor     = input.color(#26A69A, 'Uptrend color', group = 'Style')
downColor   = input.color(#EF5350, 'Downtrend color', group = 'Style')
flatColor   = input.color(color.gray, 'No-bias color', group = 'Style')
markSizeStr = input.string('Normal', 'Marker Size', options = ['Tiny','Small','Normal','Large','Huge'], group = 'Style')

grpMid = '50% Lines'
showMid1h = input.bool(true, 'Show 1H 50%', group = grpMid)
colMid1h  = input.color(#FF9800, '1H 50% color', group = grpMid)
showMid15 = input.bool(true, 'Show 15m 50%', group = grpMid)
colMid15  = input.color(#00BCD4, '15m 50% color', group = grpMid)
showMid5  = input.bool(true, 'Show 5m 50%', group = grpMid)
colMid5   = input.color(#FFEB3B, '5m 50% color', group = grpMid)
showMid1  = input.bool(true, 'Show 1m 50%', group = grpMid)
colMid1   = input.color(#E040FB, '1m 50% color', group = grpMid)
midWidth  = input.int(2, '50% line width', minval = 1, maxval = 4, group = grpMid)

markSize = markSizeStr == 'Tiny' ? size.tiny : markSizeStr == 'Small' ? size.small : markSizeStr == 'Normal' ? size.normal : markSizeStr == 'Large' ? size.large : size.huge

f_source_tf() =>
    string tf = timeframe.period
    string out = '60'
    if tf == '1'
        out := '5'
    else if tf == '5'
        out := '15'
    else if tf == '15' or tf == '30'
        out := '60'
    else if tf == '60'
        out := '60'
    else if tf == '240'
        out := '240'
    else if tf == '3'
        out := '15'
    out

srcTf = f_source_tf()
srcName = srcTf == '5' ? '5m' : srcTf == '15' ? '15m' : srcTf == '60' ? '1H' : srcTf == '240' ? '4H' : srcTf
useLocal = timeframe.period == srcTf

// =========================================================
// Fractal pack: events + rolling last H/L (for 50% mids)
// =========================================================
f_fractal_pack() =>
    float ph = ta.pivothigh(high, left, right)
    float pl = ta.pivotlow(low, left, right)
    float atr = ta.atr(atrLen)
    float minDist = minSwingAtr * atr

    var float prevH = na
    var float prevL = na
    var int   bias = 0
    var float lastH = na
    var int   lastHT = na
    var float lastL = na
    var int   lastLT = na

    float hPrice = na
    int   hTime  = na
    float lPrice = na
    int   lTime  = na

    if not na(ph)
        bool farEnough = minSwingAtr == 0 or na(prevL) or math.abs(ph - prevL) >= minDist
        bool notDup = na(prevH) or math.abs(ph - prevH) >= syminfo.mintick
        if farEnough and notDup
            if not na(prevH)
                bias := ph > prevH ? 1 : ph < prevH ? -1 : bias
            hPrice := ph
            hTime  := time[right]
            lastH := ph
            lastHT := time[right]
            prevH := ph

    if not na(pl)
        bool farEnough = minSwingAtr == 0 or na(prevH) or math.abs(pl - prevH) >= minDist
        bool notDup = na(prevL) or math.abs(pl - prevL) >= syminfo.mintick
        if farEnough and notDup
            if not na(prevL)
                bias := pl > prevL ? 1 : pl < prevL ? -1 : bias
            lPrice := pl
            lTime  := time[right]
            lastL := pl
            lastLT := time[right]
            prevL := pl

    [hPrice, hTime, lPrice, lTime, bias, lastH, lastHT, lastL, lastLT]

f_bias_color(b) =>
    b > 0 ? upColor : b < 0 ? downColor : flatColor

// ---- Markers from mapped source TF ----
float evHPrice = na
int   evHTime  = na
float evLPrice = na
int   evLTime  = na
int   evBias   = 0

if useLocal
    [eh0, eht0, el0, elt0, eb0, x0, x1, x2, x3] = f_fractal_pack()
    evHPrice := eh0
    evHTime  := eht0
    evLPrice := el0
    evLTime  := elt0
    evBias   := eb0
else
    [eh1, eht1, el1, elt1, eb1, y0, y1, y2, y3] = request.security(syminfo.tickerid, srcTf, f_fractal_pack(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
    evHPrice := eh1
    evHTime  := eht1
    evLPrice := el1
    evLTime  := elt1
    evBias   := nz(eb1, 0)

// ---- Latest H/L per TF for 50% lines (gaps_off keeps last values) ----
[a0, a1, a2, a3, a4, lastH1h, lastHT1h, lastL1h, lastLT1h] = request.security(syminfo.tickerid, '60', f_fractal_pack(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[b0, b1, b2, b3, b4, lastH15, lastHT15, lastL15, lastLT15] = request.security(syminfo.tickerid, '15', f_fractal_pack(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c0, c1, c2, c3, c4, lastH5,  lastHT5,  lastL5,  lastLT5]  = request.security(syminfo.tickerid, '5',  f_fractal_pack(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[d0, d1, d2, d3, d4, lastH1,  lastHT1,  lastL1,  lastLT1]  = request.security(syminfo.tickerid, '1',  f_fractal_pack(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// =========================================================
// Draw circles (no timeframe text, no emoji)
// =========================================================
var array<int>   hiTimes  = array.new_int()
var array<float> hiPrices = array.new_float()
var array<label> hiMarks  = array.new_label()

var array<int>   loTimes  = array.new_int()
var array<float> loPrices = array.new_float()
var array<label> loMarks  = array.new_label()

var int lastBias = 0

var line midLn1h = na
var line midLn15 = na
var line midLn5  = na
var line midLn1  = na
var float midCache1h = na
var float midCache15 = na
var float midCache5  = na
var float midCache1  = na
var int midTH1h = na
var int midTL1h = na
var int midTH15 = na
var int midTL15 = na
var int midTH5  = na
var int midTL5  = na
var int midTH1  = na
var int midTL1  = na

f_trim(arrT, arrP, arrM) =>
    if keepLastN > 0
        for i = 0 to 200
            if array.size(arrT) <= keepLastN
                break
            label.delete(array.shift(arrM))
            array.shift(arrT)
            array.shift(arrP)

f_already(arrT, arrP, t, p) =>
    bool found = false
    int n = array.size(arrT)
    if n > 0
        for i = 0 to n - 1
            if array.get(arrT, i) == t and array.get(arrP, i) == p
                found := true
                break
    found

f_set_mid(ln, show, col, h, ht, l, lt, cacheMid, cacheTH, cacheTL) =>
    line outLn = ln
    float outMid = cacheMid
    int outTH = cacheTH
    int outTL = cacheTL
    if show and not na(h) and not na(l) and not na(ht) and not na(lt)
        float mid = (h + l) / 2.0
        bool changed = na(cacheMid) or cacheMid != mid or na(cacheTH) or cacheTH != ht or na(cacheTL) or cacheTL != lt
        if changed
            if not na(outLn)
                line.delete(outLn)
            outLn := line.new(math.min(ht, lt), mid, math.max(ht, lt), mid, xloc = xloc.bar_time, extend = extend.right, color = col, width = midWidth, style = line.style_dotted)
            outMid := mid
            outTH := ht
            outTL := lt
    else
        if not na(outLn)
            line.delete(outLn)
        outLn := na
        outMid := na
        outTH := na
        outTL := na
    [outLn, outMid, outTH, outTL]

bool newHigh = not na(evHPrice) and not na(evHTime)
bool newLow  = not na(evLPrice) and not na(evLTime)

if newHigh or newLow
    lastBias := evBias

color markCol = f_bias_color(evBias)

if newHigh and not f_already(hiTimes, hiPrices, evHTime, evHPrice)
    array.push(hiTimes, evHTime)
    array.push(hiPrices, evHPrice)
    array.push(hiMarks, label.new(x = evHTime, y = evHPrice, xloc = xloc.bar_time, style = label.style_circle, size = markSize, text = '', color = markCol))
    f_trim(hiTimes, hiPrices, hiMarks)

if newLow and not f_already(loTimes, loPrices, evLTime, evLPrice)
    array.push(loTimes, evLTime)
    array.push(loPrices, evLPrice)
    array.push(loMarks, label.new(x = evLTime, y = evLPrice, xloc = xloc.bar_time, style = label.style_circle, size = markSize, text = '', color = markCol))
    f_trim(loTimes, loPrices, loMarks)

// ---- Multi-TF 50% lines ----
[nLn1h, nMid1h, nTH1h, nTL1h] = f_set_mid(midLn1h, showMid1h, colMid1h, lastH1h, lastHT1h, lastL1h, lastLT1h, midCache1h, midTH1h, midTL1h)
midLn1h := nLn1h
midCache1h := nMid1h
midTH1h := nTH1h
midTL1h := nTL1h

[nLn15, nMid15, nTH15, nTL15] = f_set_mid(midLn15, showMid15, colMid15, lastH15, lastHT15, lastL15, lastLT15, midCache15, midTH15, midTL15)
midLn15 := nLn15
midCache15 := nMid15
midTH15 := nTH15
midTL15 := nTL15

[nLn5, nMid5, nTH5, nTL5] = f_set_mid(midLn5, showMid5, colMid5, lastH5, lastHT5, lastL5, lastLT5, midCache5, midTH5, midTL5)
midLn5 := nLn5
midCache5 := nMid5
midTH5 := nTH5
midTL5 := nTL5

[nLn1, nMid1, nTH1, nTL1] = f_set_mid(midLn1, showMid1, colMid1, lastH1, lastHT1, lastL1, lastLT1, midCache1, midTH1, midTL1)
midLn1 := nLn1
midCache1 := nMid1
midTH1 := nTH1
midTL1 := nTL1

var table info = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 70))
if barstate.islast
    string biasTxt = lastBias > 0 ? 'Uptrend' : lastBias < 0 ? 'Downtrend' : 'Flat'
    color  biasCol = f_bias_color(lastBias)
    table.cell(info, 0, 0, 'Chart: ' + timeframe.period + ' → ' + srcName, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, 'Fractals Periods=' + str.tostring(periods), text_color = color.aqua, text_size = size.small)
    table.cell(info, 0, 2, 'Bias: ' + biasTxt, text_color = biasCol, text_size = size.small)
