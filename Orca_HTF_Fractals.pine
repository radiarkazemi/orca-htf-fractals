//@version=6
indicator('Orca HTF Fractals', overlay = true, max_labels_count = 500, max_lines_count = 100)

// =========================================================
// Dealing-range H/L  (NOT date-hardcoded)
//
// Example anchor on FxPro XAUUSD (NY time) — for testing only:
//   Fri 31 Jul 2026 02:00 lower-high  +  10:00 leg-low
// Any other major leg on the chart is marked the same way.
//
// Method:
//   1) Major ZigZag leg when move >= zzAtr × ATR
//   2) On a bearish leg: DR high = last internal fractal
//      lower-high BEFORE the leg low; DR low = leg low
//   3) On a bullish leg: mirror (internal higher-low + leg high)
//   4) When the leg reverses, that pair is FINALIZED into history
//   5) Active leg also shows a live updating pair
//
// Map: 1H→1H | 15m→1H | 5m→15m | 1m→5m
// =========================================================

left  = input.int(2, 'Pivot Left',  minval = 1, group = 'Structure')
right = input.int(2, 'Pivot Right', minval = 1, group = 'Structure')

zzAtr  = input.float(3.0, 'Major leg (× ATR)', minval = 0.5, step = 0.5, group = 'Filter', tooltip = 'Lower = more dealing ranges. Raise = fewer / bigger legs.')
atrLen = input.int(14, 'ATR Length', minval = 1, group = 'Filter')
keepLastN = input.int(12, 'Keep last N highs + N lows (0 = all)', minval = 0, group = 'Filter')
onlyLatestPair = input.bool(false, 'Show ONLY latest High + latest Low', group = 'Filter')
showLive = input.bool(true, 'Show live (in-progress) dealing range', group = 'Filter')

highColor   = input.color(color.red,  'High Color', group = 'Style')
lowColor    = input.color(color.lime, 'Low Color',  group = 'Style')
markSizeStr = input.string('Normal', 'Marker Size', options = ['Tiny','Small','Normal','Large','Huge'], group = 'Style')
showTags    = input.bool(true, 'Show H/L tags', group = 'Style')
showEmoji   = input.bool(true, 'Show 😊 on markers', group = 'Style')
showMid     = input.bool(true, 'Show 50% of latest H/L', group = 'Style')
midColor    = input.color(color.orange, '50% color', group = 'Style')

markSize = markSizeStr == 'Tiny' ? size.tiny : markSizeStr == 'Small' ? size.small : markSizeStr == 'Normal' ? size.normal : markSizeStr == 'Large' ? size.large : size.huge

f_source_tf() =>
    string tf = timeframe.period
    string out = '60'
    if tf == '1'
        out := '5'
    else if tf == '5'
        out := '15'
    else if tf == '15' or tf == '30'
        out := '60'
    else if tf == '60'
        out := '60'
    else if tf == '240'
        out := '240'
    else if tf == '3'
        out := '15'
    out

srcTf = f_source_tf()
srcName = srcTf == '5' ? '5m' : srcTf == '15' ? '15m' : srcTf == '60' ? '1H' : srcTf == '240' ? '4H' : srcTf
useLocal = timeframe.period == srcTf

// =========================================================
// Returns:
//   finH/finHT / finL/finLT  — finalized pair when a major leg completes (else na)
//   liveH/liveHT / liveL/liveLT — current in-progress pair (else na)
// =========================================================
f_dr_event() =>
    float ph = ta.pivothigh(high, left, right)
    float pl = ta.pivotlow(low,  left, right)
    float atr = ta.atr(atrLen)
    float thr = zzAtr * atr

    var int   dir = 0
    var float legHi = na
    var int   legHiT = na
    var float legLo = na
    var int   legLoT = na
    var float intPx = na
    var int   intT = na
    var bool  legActive = false

    float finH = na
    int   finHT = na
    float finL = na
    int   finLT = na
    float liveH = na
    int   liveHT = na
    float liveL = na
    int   liveLT = na

    // Internals must be at/before the current extreme (ignore post-extreme bounces)
    if not na(ph) and dir == -1
        int pT = time[right]
        if na(legLoT) or pT <= legLoT
            intPx := ph
            intT := pT
    if not na(pl) and dir == 1
        int pT2 = time[right]
        if na(legHiT) or pT2 <= legHiT
            intPx := pl
            intT := pT2

    bool flipped = false

    if dir == 0
        if na(legHi)
            legHi := high
            legHiT := time
            legLo := low
            legLoT := time
        else
            if high >= legHi
                legHi := high
                legHiT := time
            if low <= legLo
                legLo := low
                legLoT := time
            if legHi - legLo >= thr
                dir := legHiT >= legLoT ? -1 : 1
                intPx := na
                intT := na
                legActive := true
    else if dir == -1
        if high > legHi
            legHi := high
            legHiT := time
            legLo := low
            legLoT := time
            intPx := na
            intT := na
            legActive := false
        else
            if low <= legLo
                legLo := low
                legLoT := time
            if legHi - legLo >= thr
                legActive := true
            // Reverse up by thr → finalize bearish dealing range
            if legActive and high - legLo >= thr
                finH := not na(intPx) ? intPx : legHi
                finHT := not na(intT) ? intT : legHiT
                finL := legLo
                finLT := legLoT
                dir := 1
                legHi := high
                legHiT := time
                intPx := na
                intT := na
                legActive := true
                flipped := true
    else if dir == 1
        if low < legLo
            legLo := low
            legLoT := time
            legHi := high
            legHiT := time
            intPx := na
            intT := na
            legActive := false
        else
            if high >= legHi
                legHi := high
                legHiT := time
            if legHi - legLo >= thr
                legActive := true
            // Reverse down by thr → finalize bullish dealing range
            if legActive and legHi - low >= thr
                finL := not na(intPx) ? intPx : legLo
                finLT := not na(intT) ? intT : legLoT
                finH := legHi
                finHT := legHiT
                dir := -1
                legLo := low
                legLoT := time
                intPx := na
                intT := na
                legActive := true
                flipped := true

    // Live in-progress pair (not on the finalize bar)
    if legActive and not flipped
        if dir == -1
            liveH := not na(intPx) ? intPx : legHi
            liveHT := not na(intT) ? intT : legHiT
            liveL := legLo
            liveLT := legLoT
        else if dir == 1
            liveL := not na(intPx) ? intPx : legLo
            liveLT := not na(intT) ? intT : legLoT
            liveH := legHi
            liveHT := legHiT

    [finH, finHT, finL, finLT, liveH, liveHT, liveL, liveLT]

float finH = na
int   finHT = na
float finL = na
int   finLT = na
float liveH = na
int   liveHT = na
float liveL = na
int   liveLT = na

if useLocal
    [a0, b0, c0, d0, e0, f0, g0, h0] = f_dr_event()
    finH := a0
    finHT := b0
    finL := c0
    finLT := d0
    liveH := e0
    liveHT := f0
    liveL := g0
    liveLT := h0
else
    [a1, b1, c1, d1, e1, f1, g1, h1] = request.security(syminfo.tickerid, srcTf, f_dr_event(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
    finH := a1
    finHT := b1
    finL := c1
    finLT := d1
    liveH := e1
    liveHT := f1
    liveL := g1
    liveLT := h1

// =========================================================
// History (finalized legs) + live labels
// =========================================================
var array<int>   hiTimes  = array.new_int()
var array<float> hiPrices = array.new_float()
var array<label> hiMarks  = array.new_label()
var array<label> hiTags   = array.new_label()
var array<label> hiEmos   = array.new_label()

var array<int>   loTimes  = array.new_int()
var array<float> loPrices = array.new_float()
var array<label> loMarks  = array.new_label()
var array<label> loTags   = array.new_label()
var array<label> loEmos   = array.new_label()

var label liveHMark = na
var label liveHTag = na
var label liveHEmo = na
var label liveLMark = na
var label liveLTag = na
var label liveLEmo = na
var float liveHPx = na
var int   liveHTm = na
var float liveLPx = na
var int   liveLTm = na

var line midLn = na

f_del_side(arrM, arrG, arrE, arrT, arrP) =>
    if array.size(arrM) > 0
        label.delete(array.pop(arrM))
        label oldG = array.pop(arrG)
        if not na(oldG)
            label.delete(oldG)
        label oldE = array.pop(arrE)
        if not na(oldE)
            label.delete(oldE)
        array.pop(arrT)
        array.pop(arrP)

f_trim(arrT, arrP, arrM, arrG, arrE) =>
    if keepLastN > 0
        for i = 0 to 200
            if array.size(arrT) <= keepLastN
                break
            label.delete(array.shift(arrM))
            label oldG = array.shift(arrG)
            if not na(oldG)
                label.delete(oldG)
            label oldE = array.shift(arrE)
            if not na(oldE)
                label.delete(oldE)
            array.shift(arrT)
            array.shift(arrP)

f_already(arrT, arrP, t, p) =>
    bool found = false
    int n = array.size(arrT)
    if n > 0
        for i = 0 to n - 1
            if array.get(arrT, i) == t and array.get(arrP, i) == p
                found := true
                break
    found

f_add_high(t, p) =>
    array.push(hiTimes, t)
    array.push(hiPrices, p)
    array.push(hiMarks, label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_triangledown, size = markSize, text = '', color = highColor))
    array.push(hiTags, showTags ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_label_down, size = size.small, text = srcName + ' H', textcolor = highColor, color = color.new(color.black, 100)) : na)
    array.push(hiEmos, showEmoji ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)

f_add_low(t, p) =>
    array.push(loTimes, t)
    array.push(loPrices, p)
    array.push(loMarks, label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_triangleup, size = markSize, text = '', color = lowColor))
    array.push(loTags, showTags ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_label_up, size = size.small, text = srcName + ' L', textcolor = lowColor, color = color.new(color.black, 100)) : na)
    array.push(loEmos, showEmoji ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)

// --- Finalized historical pairs (many legs) ---
bool gotFinH = not na(finH) and not na(finHT)
bool gotFinL = not na(finL) and not na(finLT)

if gotFinH and not f_already(hiTimes, hiPrices, finHT, finH)
    if onlyLatestPair
        f_del_side(hiMarks, hiTags, hiEmos, hiTimes, hiPrices)
    f_add_high(finHT, finH)
    f_trim(hiTimes, hiPrices, hiMarks, hiTags, hiEmos)

if gotFinL and not f_already(loTimes, loPrices, finLT, finL)
    if onlyLatestPair
        f_del_side(loMarks, loTags, loEmos, loTimes, loPrices)
    f_add_low(finLT, finL)
    f_trim(loTimes, loPrices, loMarks, loTags, loEmos)

// --- Live in-progress pair ---
if showLive
    if not na(liveH) and not na(liveHT)
        if na(liveHTm) or liveHTm != liveHT or na(liveHPx) or liveHPx != liveH
            if not na(liveHMark)
                label.delete(liveHMark)
            if not na(liveHTag)
                label.delete(liveHTag)
            if not na(liveHEmo)
                label.delete(liveHEmo)
            liveHMark := label.new(x = liveHT, y = liveH, xloc = xloc.bar_time, style = label.style_triangledown, size = markSize, text = '', color = highColor)
            liveHTag := showTags ? label.new(x = liveHT, y = liveH, xloc = xloc.bar_time, style = label.style_label_down, size = size.small, text = srcName + ' H', textcolor = highColor, color = color.new(color.black, 100)) : na
            liveHEmo := showEmoji ? label.new(x = liveHT, y = liveH, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na
            liveHPx := liveH
            liveHTm := liveHT
    if not na(liveL) and not na(liveLT)
        if na(liveLTm) or liveLTm != liveLT or na(liveLPx) or liveLPx != liveL
            if not na(liveLMark)
                label.delete(liveLMark)
            if not na(liveLTag)
                label.delete(liveLTag)
            if not na(liveLEmo)
                label.delete(liveLEmo)
            liveLMark := label.new(x = liveLT, y = liveL, xloc = xloc.bar_time, style = label.style_triangleup, size = markSize, text = '', color = lowColor)
            liveLTag := showTags ? label.new(x = liveLT, y = liveL, xloc = xloc.bar_time, style = label.style_label_up, size = size.small, text = srcName + ' L', textcolor = lowColor, color = color.new(color.black, 100)) : na
            liveLEmo := showEmoji ? label.new(x = liveLT, y = liveL, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na
            liveLPx := liveL
            liveLTm := liveLT
else
    if not na(liveHMark)
        label.delete(liveHMark)
    if not na(liveHTag)
        label.delete(liveHTag)
    if not na(liveHEmo)
        label.delete(liveHEmo)
    if not na(liveLMark)
        label.delete(liveLMark)
    if not na(liveLTag)
        label.delete(liveLTag)
    if not na(liveLEmo)
        label.delete(liveLEmo)
    liveHMark := na
    liveHTag := na
    liveHEmo := na
    liveLMark := na
    liveLTag := na
    liveLEmo := na
    liveHPx := na
    liveHTm := na
    liveLPx := na
    liveLTm := na

// 50% of latest available pair (prefer live, else last finalized)
float midH = not na(liveHPx) ? liveHPx : array.size(hiPrices) > 0 ? array.get(hiPrices, array.size(hiPrices) - 1) : na
float midL = not na(liveLPx) ? liveLPx : array.size(loPrices) > 0 ? array.get(loPrices, array.size(loPrices) - 1) : na
int   midHT = not na(liveHTm) ? liveHTm : array.size(hiTimes) > 0 ? array.get(hiTimes, array.size(hiTimes) - 1) : na
int   midLT = not na(liveLTm) ? liveLTm : array.size(loTimes) > 0 ? array.get(loTimes, array.size(loTimes) - 1) : na

if showMid and not na(midH) and not na(midL) and not na(midHT) and not na(midLT)
    if gotFinH or gotFinL or (showLive and (not na(liveH) or not na(liveL)))
        if not na(midLn)
            line.delete(midLn)
        float mid = (midH + midL) / 2.0
        midLn := line.new(math.min(midHT, midLT), mid, math.max(midHT, midLT), mid, xloc = xloc.bar_time, extend = extend.right, color = midColor, width = 2, style = line.style_dotted)

var table info = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 70))
if barstate.islast
    table.cell(info, 0, 0, 'Chart: ' + timeframe.period, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, 'Showing: ' + srcName + ' dealing ranges', text_color = color.aqua, text_size = size.small)
    string lastHL = not na(midH) and not na(midL) ? str.tostring(midH, format.mintick) + ' / ' + str.tostring(midL, format.mintick) : '—'
    table.cell(info, 0, 2, 'Active H/L: ' + lastHL, text_color = color.yellow, text_size = size.small)
