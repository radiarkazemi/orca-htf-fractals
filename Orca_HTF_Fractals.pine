//@version=6
indicator('Orca HTF Fractals', overlay = true, max_labels_count = 500, max_lines_count = 100)

// =========================================================
// Dealing-range H/L
//
// Anchor (FxPro XAUUSD, America/New_York):
//   Fri 31 Jul 2026  02:00  → HIGH  (~4088)
//   Fri 31 Jul 2026  10:00  → LOW   (~4022)
//
// 02:00 is a LOWER HIGH after the Jul 30 peak. Strict HH/MS
// kept the peak and skipped 02:00 — that was the bug.
//
// Method:
//   Major ZigZag leg (min size = zzAtr × ATR).
//   DR high/low on a bearish leg =
//     last INTERNAL fractal lower-high BEFORE the leg low
//     + the leg low itself
//   (so 02:00 + 10:00, not the Jul 30 peak).
//   Internals after the extreme (bounce highs) are ignored.
//
// Map: 1H→1H | 15m→1H | 5m→15m | 1m→5m
// =========================================================

left  = input.int(2, 'Pivot Left',  minval = 1, group = 'Structure')
right = input.int(2, 'Pivot Right', minval = 1, group = 'Structure')

zzAtr  = input.float(3.0, 'Major leg (× ATR)', minval = 0.5, step = 0.5, group = 'Filter', tooltip = 'Raise to show fewer dealing ranges.')
atrLen = input.int(14, 'ATR Length', minval = 1, group = 'Filter')
keepLastN = input.int(4, 'Keep last N highs + N lows (0 = all)', minval = 0, group = 'Filter')
onlyLatestPair = input.bool(true, 'Show ONLY latest High + latest Low', group = 'Filter')

highColor   = input.color(color.red,  'High Color', group = 'Style')
lowColor    = input.color(color.lime, 'Low Color',  group = 'Style')
markSizeStr = input.string('Normal', 'Marker Size', options = ['Tiny','Small','Normal','Large','Huge'], group = 'Style')
showTags    = input.bool(true, 'Show H/L tags', group = 'Style')
showEmoji   = input.bool(true, 'Show 😊 on markers', group = 'Style')
showMid     = input.bool(true, 'Show 50% of latest H/L', group = 'Style')
midColor    = input.color(color.orange, '50% color', group = 'Style')

markSize = markSizeStr == 'Tiny' ? size.tiny : markSizeStr == 'Small' ? size.small : markSizeStr == 'Normal' ? size.normal : markSizeStr == 'Large' ? size.large : size.huge

f_source_tf() =>
    string tf = timeframe.period
    string out = '60'
    if tf == '1'
        out := '5'
    else if tf == '5'
        out := '15'
    else if tf == '15' or tf == '30'
        out := '60'
    else if tf == '60'
        out := '60'
    else if tf == '240'
        out := '240'
    else if tf == '3'
        out := '15'
    out

srcTf = f_source_tf()
srcName = srcTf == '5' ? '5m' : srcTf == '15' ? '15m' : srcTf == '60' ? '1H' : srcTf == '240' ? '4H' : srcTf
useLocal = timeframe.period == srcTf

// =========================================================
// Active dealing-range on the current major leg
// =========================================================
f_dr_event() =>
    float ph = ta.pivothigh(high, left, right)
    float pl = ta.pivotlow(low,  left, right)
    float atr = ta.atr(atrLen)
    float thr = zzAtr * atr

    var int   dir = 0
    var float legHi = na
    var int   legHiT = na
    var float legLo = na
    var int   legLoT = na
    var float intPx = na
    var int   intT = na
    var bool  legActive = false

    var float curH = na
    var int   curHT = na
    var float curL = na
    var int   curLT = na

    float outH = na
    int   outHT = na
    int   outHChg = 0
    float outL = na
    int   outLT = na
    int   outLChg = 0

    // Internal pivots MUST sit before the current leg extreme in time
    // (blocks bounce highs like Fri 15:00 from replacing 02:00)
    if not na(ph) and dir == -1
        int pT = time[right]
        if na(legLoT) or pT <= legLoT
            intPx := ph
            intT := pT
    if not na(pl) and dir == 1
        int pT2 = time[right]
        if na(legHiT) or pT2 <= legHiT
            intPx := pl
            intT := pT2

    if dir == 0
        if na(legHi)
            legHi := high
            legHiT := time
            legLo := low
            legLoT := time
        else
            if high >= legHi
                legHi := high
                legHiT := time
            if low <= legLo
                legLo := low
                legLoT := time
            if legHi - legLo >= thr
                if legHiT >= legLoT
                    dir := -1
                else
                    dir := 1
                intPx := na
                intT := na
                legActive := true
    else if dir == -1
        if high > legHi
            legHi := high
            legHiT := time
            legLo := low
            legLoT := time
            intPx := na
            intT := na
            legActive := false
        else
            if low <= legLo
                legLo := low
                legLoT := time
            if legHi - legLo >= thr
                legActive := true
            if legActive and high - legLo >= thr
                dir := 1
                legHi := high
                legHiT := time
                intPx := na
                intT := na
                legActive := true
    else if dir == 1
        if low < legLo
            legLo := low
            legLoT := time
            legHi := high
            legHiT := time
            intPx := na
            intT := na
            legActive := false
        else
            if high >= legHi
                legHi := high
                legHiT := time
            if legHi - legLo >= thr
                legActive := true
            if legActive and legHi - low >= thr
                dir := -1
                legLo := low
                legLoT := time
                intPx := na
                intT := na
                legActive := true

    if legActive and dir == -1
        float hPx = not na(intPx) ? intPx : legHi
        int   hTm = not na(intT) ? intT : legHiT
        if na(curH) or curH != hPx or na(curHT) or curHT != hTm
            outH := hPx
            outHT := hTm
            outHChg := 1
            curH := hPx
            curHT := hTm
        if na(curL) or curL != legLo or na(curLT) or curLT != legLoT
            outL := legLo
            outLT := legLoT
            outLChg := 1
            curL := legLo
            curLT := legLoT
    else if legActive and dir == 1
        float lPx = not na(intPx) ? intPx : legLo
        int   lTm = not na(intT) ? intT : legLoT
        if na(curL) or curL != lPx or na(curLT) or curLT != lTm
            outL := lPx
            outLT := lTm
            outLChg := 1
            curL := lPx
            curLT := lTm
        if na(curH) or curH != legHi or na(curHT) or curHT != legHiT
            outH := legHi
            outHT := legHiT
            outHChg := 1
            curH := legHi
            curHT := legHiT

    [outH, outHT, outHChg, outL, outLT, outLChg]

float evHPrice = na
int   evHTime  = na
int   evHChg   = 0
float evLPrice = na
int   evLTime  = na
int   evLChg   = 0

if useLocal
    [h0, ht0, hc0, l0, lt0, lc0] = f_dr_event()
    evHPrice := h0
    evHTime  := ht0
    evHChg   := hc0
    evLPrice := l0
    evLTime  := lt0
    evLChg   := lc0
else
    [h1, ht1, hc1, l1, lt1, lc1] = request.security(syminfo.tickerid, srcTf, f_dr_event(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
    evHPrice := h1
    evHTime  := ht1
    evHChg   := hc1
    evLPrice := l1
    evLTime  := lt1
    evLChg   := lc1

// =========================================================
// Draw — default = only the active dealing-range pair
// =========================================================
var array<int>   hiTimes  = array.new_int()
var array<float> hiPrices = array.new_float()
var array<label> hiMarks  = array.new_label()
var array<label> hiTags   = array.new_label()
var array<label> hiEmos   = array.new_label()

var array<int>   loTimes  = array.new_int()
var array<float> loPrices = array.new_float()
var array<label> loMarks  = array.new_label()
var array<label> loTags   = array.new_label()
var array<label> loEmos   = array.new_label()

var line midLn = na

f_del_side(arrM, arrG, arrE, arrT, arrP) =>
    if array.size(arrM) > 0
        label.delete(array.pop(arrM))
        label oldG = array.pop(arrG)
        if not na(oldG)
            label.delete(oldG)
        label oldE = array.pop(arrE)
        if not na(oldE)
            label.delete(oldE)
        array.pop(arrT)
        array.pop(arrP)

f_trim(arrT, arrP, arrM, arrG, arrE) =>
    if keepLastN > 0
        for i = 0 to 100
            if array.size(arrT) <= keepLastN
                break
            label.delete(array.shift(arrM))
            label oldG = array.shift(arrG)
            if not na(oldG)
                label.delete(oldG)
            label oldE = array.shift(arrE)
            if not na(oldE)
                label.delete(oldE)
            array.shift(arrT)
            array.shift(arrP)

f_already(arrT, arrP, t, p) =>
    bool found = false
    int n = array.size(arrT)
    if n > 0
        for i = 0 to n - 1
            if array.get(arrT, i) == t and array.get(arrP, i) == p
                found := true
                break
    found

f_add_high(t, p) =>
    array.push(hiTimes, t)
    array.push(hiPrices, p)
    array.push(hiMarks, label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_triangledown, size = markSize, text = '', color = highColor))
    array.push(hiTags, showTags ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_label_down, size = size.small, text = srcName + ' H', textcolor = highColor, color = color.new(color.black, 100)) : na)
    array.push(hiEmos, showEmoji ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)

f_add_low(t, p) =>
    array.push(loTimes, t)
    array.push(loPrices, p)
    array.push(loMarks, label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_triangleup, size = markSize, text = '', color = lowColor))
    array.push(loTags, showTags ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_label_up, size = size.small, text = srcName + ' L', textcolor = lowColor, color = color.new(color.black, 100)) : na)
    array.push(loEmos, showEmoji ? label.new(x = t, y = p, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)

bool newHigh = evHChg == 1 and not na(evHPrice) and not na(evHTime)
bool newLow  = evLChg == 1 and not na(evLPrice) and not na(evLTime)

if newHigh and not f_already(hiTimes, hiPrices, evHTime, evHPrice)
    f_del_side(hiMarks, hiTags, hiEmos, hiTimes, hiPrices)
    f_add_high(evHTime, evHPrice)
    if not onlyLatestPair
        f_trim(hiTimes, hiPrices, hiMarks, hiTags, hiEmos)

if newLow and not f_already(loTimes, loPrices, evLTime, evLPrice)
    f_del_side(loMarks, loTags, loEmos, loTimes, loPrices)
    f_add_low(evLTime, evLPrice)
    if not onlyLatestPair
        f_trim(loTimes, loPrices, loMarks, loTags, loEmos)

// Note: with onlyLatestPair (default) we always keep exactly one H + one L
// by replacing on each update — that is the active dealing range.

if showMid and array.size(hiPrices) > 0 and array.size(loPrices) > 0
    if newHigh or newLow
        if not na(midLn)
            line.delete(midLn)
        float lh = array.get(hiPrices, array.size(hiPrices) - 1)
        float ll = array.get(loPrices, array.size(loPrices) - 1)
        int   th = array.get(hiTimes, array.size(hiTimes) - 1)
        int   tl = array.get(loTimes, array.size(loTimes) - 1)
        float mid = (lh + ll) / 2.0
        midLn := line.new(math.min(th, tl), mid, math.max(th, tl), mid, xloc = xloc.bar_time, extend = extend.right, color = midColor, width = 2, style = line.style_dotted)

var table info = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 70))
if barstate.islast
    table.cell(info, 0, 0, 'Chart: ' + timeframe.period, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, 'Showing: ' + srcName + ' dealing range', text_color = color.aqua, text_size = size.small)
    string lastHL = array.size(hiPrices) > 0 and array.size(loPrices) > 0 ? str.tostring(array.get(hiPrices, array.size(hiPrices) - 1), format.mintick) + ' / ' + str.tostring(array.get(loPrices, array.size(loPrices) - 1), format.mintick) : '—'
    table.cell(info, 0, 2, 'DR H/L: ' + lastHL, text_color = color.yellow, text_size = size.small)
