//@version=6
indicator('Orca HTF Fractals', overlay = true, max_labels_count = 500, max_lines_count = 100)

// =========================================================
// Williams Fractals (same as TradingView "Fractals")
//
// Periods = N  →  N bars left + N bars right (TV default UI)
// Your Fractals chart uses Periods = 3  (not 2).
//
// Up fractal   = pivot HIGH  → teal ▲
// Down fractal = pivot LOW   → red ▼
//
// Test anchors (1H, NY) — not hardcoded:
//   Fri 31 Jul 2026 02:00 H / 10:00 L
//   Wed  5 Aug 2026 03:00 H / 06:00 L
//
// Map: 1H→1H | 15m→1H | 5m→15m | 1m→5m
// =========================================================

periods = input.int(3, 'Periods', minval = 2, group = 'Fractal', tooltip = 'Same as TradingView Fractals → Periods. 3 = less noise than 2.')
left  = periods
right = periods

minSwingAtr = input.float(0.0, 'Min swing (× ATR)', minval = 0.0, step = 0.1, group = 'Filter', tooltip = '0 = every fractal. Raise only if you still want fewer marks.')
atrLen      = input.int(14, 'ATR Length', minval = 1, group = 'Filter')
keepLastN   = input.int(50, 'Keep last N highs + N lows (0 = all)', minval = 0, group = 'Filter')

// Match TradingView Fractals arrow colors by default
highColor   = input.color(#26A69A, 'Up fractal (High)', group = 'Style')
lowColor    = input.color(#EF5350, 'Down fractal (Low)', group = 'Style')
markSizeStr = input.string('Normal', 'Marker Size', options = ['Tiny','Small','Normal','Large','Huge'], group = 'Style')
showTags    = input.bool(true, 'Show H/L tags', group = 'Style')
showEmoji   = input.bool(true, 'Show 😊 on markers', group = 'Style')
showMid     = input.bool(true, 'Show 50% of latest H/L', group = 'Style')
midColor    = input.color(color.orange, '50% color', group = 'Style')

markSize = markSizeStr == 'Tiny' ? size.tiny : markSizeStr == 'Small' ? size.small : markSizeStr == 'Normal' ? size.normal : markSizeStr == 'Large' ? size.large : size.huge

f_source_tf() =>
    string tf = timeframe.period
    string out = '60'
    if tf == '1'
        out := '5'
    else if tf == '5'
        out := '15'
    else if tf == '15' or tf == '30'
        out := '60'
    else if tf == '60'
        out := '60'
    else if tf == '240'
        out := '240'
    else if tf == '3'
        out := '15'
    out

srcTf = f_source_tf()
srcName = srcTf == '5' ? '5m' : srcTf == '15' ? '15m' : srcTf == '60' ? '1H' : srcTf == '240' ? '4H' : srcTf
useLocal = timeframe.period == srcTf

// =========================================================
// Fractal engine (ta.pivothigh / ta.pivotlow = Williams)
// Confirms `right` bars after the pivot candle.
// =========================================================
f_fractal_event() =>
    float ph = ta.pivothigh(high, left, right)
    float pl = ta.pivotlow(low, left, right)
    float atr = ta.atr(atrLen)
    float minDist = minSwingAtr * atr

    var float prevH = na
    var float prevL = na

    float hPrice = na
    int   hTime  = na
    float lPrice = na
    int   lTime  = na

    if not na(ph)
        bool farEnough = minSwingAtr == 0 or na(prevL) or math.abs(ph - prevL) >= minDist
        bool notDup = na(prevH) or math.abs(ph - prevH) >= syminfo.mintick
        if farEnough and notDup
            hPrice := ph
            hTime  := time[right]
            prevH := ph

    if not na(pl)
        bool farEnough = minSwingAtr == 0 or na(prevH) or math.abs(pl - prevH) >= minDist
        bool notDup = na(prevL) or math.abs(pl - prevL) >= syminfo.mintick
        if farEnough and notDup
            lPrice := pl
            lTime  := time[right]
            prevL := pl

    [hPrice, hTime, lPrice, lTime]

float evHPrice = na
int   evHTime  = na
float evLPrice = na
int   evLTime  = na

if useLocal
    [h0, ht0, l0, lt0] = f_fractal_event()
    evHPrice := h0
    evHTime  := ht0
    evLPrice := l0
    evLTime  := lt0
else
    [h1, ht1, l1, lt1] = request.security(syminfo.tickerid, srcTf, f_fractal_event(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
    evHPrice := h1
    evHTime  := ht1
    evLPrice := l1
    evLTime  := lt1

// =========================================================
// Draw every confirmed fractal (history kept)
// =========================================================
var array<int>   hiTimes  = array.new_int()
var array<float> hiPrices = array.new_float()
var array<label> hiMarks  = array.new_label()
var array<label> hiTags   = array.new_label()
var array<label> hiEmos   = array.new_label()

var array<int>   loTimes  = array.new_int()
var array<float> loPrices = array.new_float()
var array<label> loMarks  = array.new_label()
var array<label> loTags   = array.new_label()
var array<label> loEmos   = array.new_label()

var line midLn = na

f_trim(arrT, arrP, arrM, arrG, arrE) =>
    if keepLastN > 0
        for i = 0 to 200
            if array.size(arrT) <= keepLastN
                break
            label.delete(array.shift(arrM))
            label oldG = array.shift(arrG)
            if not na(oldG)
                label.delete(oldG)
            label oldE = array.shift(arrE)
            if not na(oldE)
                label.delete(oldE)
            array.shift(arrT)
            array.shift(arrP)

f_already(arrT, arrP, t, p) =>
    bool found = false
    int n = array.size(arrT)
    if n > 0
        for i = 0 to n - 1
            if array.get(arrT, i) == t and array.get(arrP, i) == p
                found := true
                break
    found

bool newHigh = not na(evHPrice) and not na(evHTime)
bool newLow  = not na(evLPrice) and not na(evLTime)

// Up fractal = HIGH → ▲ above (TradingView Fractals green/teal)
if newHigh and not f_already(hiTimes, hiPrices, evHTime, evHPrice)
    array.push(hiTimes, evHTime)
    array.push(hiPrices, evHPrice)
    array.push(hiMarks, label.new(x = evHTime, y = evHPrice, xloc = xloc.bar_time, style = label.style_triangleup, size = markSize, text = '', color = highColor))
    array.push(hiTags, showTags ? label.new(x = evHTime, y = evHPrice, xloc = xloc.bar_time, style = label.style_label_down, size = size.small, text = srcName + ' H', textcolor = highColor, color = color.new(color.black, 100)) : na)
    array.push(hiEmos, showEmoji ? label.new(x = evHTime, y = evHPrice, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)
    f_trim(hiTimes, hiPrices, hiMarks, hiTags, hiEmos)

// Down fractal = LOW → ▼ below (TradingView Fractals red)
if newLow and not f_already(loTimes, loPrices, evLTime, evLPrice)
    array.push(loTimes, evLTime)
    array.push(loPrices, evLPrice)
    array.push(loMarks, label.new(x = evLTime, y = evLPrice, xloc = xloc.bar_time, style = label.style_triangledown, size = markSize, text = '', color = lowColor))
    array.push(loTags, showTags ? label.new(x = evLTime, y = evLPrice, xloc = xloc.bar_time, style = label.style_label_up, size = size.small, text = srcName + ' L', textcolor = lowColor, color = color.new(color.black, 100)) : na)
    array.push(loEmos, showEmoji ? label.new(x = evLTime, y = evLPrice, xloc = xloc.bar_time, style = label.style_none, size = size.normal, text = '😊', textcolor = color.yellow, color = color.new(color.black, 100)) : na)
    f_trim(loTimes, loPrices, loMarks, loTags, loEmos)

if showMid and array.size(hiPrices) > 0 and array.size(loPrices) > 0
    if newHigh or newLow
        if not na(midLn)
            line.delete(midLn)
        float lh = array.get(hiPrices, array.size(hiPrices) - 1)
        float ll = array.get(loPrices, array.size(loPrices) - 1)
        int   th = array.get(hiTimes, array.size(hiTimes) - 1)
        int   tl = array.get(loTimes, array.size(loTimes) - 1)
        float mid = (lh + ll) / 2.0
        midLn := line.new(math.min(th, tl), mid, math.max(th, tl), mid, xloc = xloc.bar_time, extend = extend.right, color = midColor, width = 2, style = line.style_dotted)

var table info = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 70))
if barstate.islast
    table.cell(info, 0, 0, 'Chart: ' + timeframe.period + ' → ' + srcName, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, 'Fractals Periods=' + str.tostring(periods), text_color = color.aqua, text_size = size.small)
    string lastHL = array.size(hiPrices) > 0 and array.size(loPrices) > 0 ? str.tostring(array.get(hiPrices, array.size(hiPrices) - 1), format.mintick) + ' / ' + str.tostring(array.get(loPrices, array.size(loPrices) - 1), format.mintick) : '—'
    table.cell(info, 0, 2, 'Latest H/L: ' + lastHL, text_color = color.yellow, text_size = size.small)
